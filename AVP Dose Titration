
--Determining what proportion of subjects experienced vasopressin dose titration following initiation--

--Pulling all vasopressin data for our analytic sample--
--Created table (avp_titration) that has stay_id, time0, avpstartdose, and avpstartdose cohort (0.03 or 0.04 units/min) for our analytic sample--


CREATE OR REPLACE TABLE mimic-iv-ext-2025.avp.vasopressin AS
SELECT
    i.stay_id, i.linkorderid
    , CASE WHEN i.rateuom = 'units/hour' THEN i.rate / 60.0
        ELSE i.rate END AS vaso_rate
    , i.amount AS vaso_amount
    , i.starttime
    , i.endtime
FROM physionet-data.mimiciv_3_1_icu.inputevents i
WHERE i.itemid = 222315 AND i.stay_id IN (
    SELECT DISTINCT a.stay_id
      FROM mimic-iv-ext-2025.avp.avp_titration a);



--Scanning the first 3 hours for each subject to determine if there was a titration in vasopressin dose above or below the upper/lower bound for their cohort--

CREATE OR REPLACE TABLE mimic-iv-ext-2025.avp.avp_titration_3h AS
SELECT
a.stay_id,
a.time0,
a.avpstartdose_hfhs,
MAX(v.vaso_rate) AS max_dose_3h,
    CASE
        WHEN a.avpstartdose_hfhs = '0.03 units/min' AND MAX(v.vaso_rate) > 0.035  THEN 1
        WHEN a.avpstartdose_hfhs = '0.04 units/min' AND MAX(v.vaso_rate) > 0.045 THEN 1 
        ELSE 0
    END AS dose_increased_above_bound_3h,
MIN(v.vaso_rate) AS min_dose_3h,
    CASE
        WHEN a.avpstartdose_hfhs= '0.03 units/min' AND MIN(v.vaso_rate) < 0.025 THEN 1
        WHEN a.avpstartdose_hfhs= '0.04 units/min' AND MIN(v.vaso_rate) < 0.035 THEN 1  
        ELSE 0
    END AS dose_decrease_below_bound_3h
FROM mimic-iv-ext-2025.avp.avp_titration a
    LEFT JOIN mimic-iv-ext-2025.avp.vasopressin v
    ON a.stay_id = v.stay_id
    AND v.starttime >= a.time0
AND v.starttime <= TIMESTAMP_ADD(a.time0, INTERVAL 3 HOUR)
GROUP BY
    a.stay_id,
    a.time0,
    a.avpstartdose_hfhs;




