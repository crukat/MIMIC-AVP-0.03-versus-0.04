--Merging all titration variables into one table--
--Hadm_id 29568899 has NULL values for max dose(got assigned a new stay_id - unsure why- so this code will not pick up vasopresin titration). Manually verified that no titration occurred. 

CREATE OR REPLACE TABLE mimic-iv-ext-2025.avp.avp_titration_upper_lower_bounds AS
SELECT h3.stay_id, h3.max_dose_3h, h3.dose_increased_above_bound_3h, h3.min_dose_3h, h3.dose_decrease_below_bound_3h, h6.max_dose_6h, h6.dose_increased_above_bound_6h, h6.min_dose_6h, h6.dose_decrease_below_bound_6h, h12.max_dose_12h, h12.dose_increased_above_bound_12h, h12.min_dose_12h, h12.dose_decrease_below_bound_12h, h24.max_dose_24h, h24.dose_increased_above_bound24h, h24.min_dose_24h, h24.dose_decrease_below_bound_24h
    FROM mimic-iv-ext-2025.avp.avp_titration_3h h3
        LEFT JOIN mimic-iv-ext-2025.avp.avp_titration_6h h6
            ON h3.stay_id = h6.stay_id
                LEFT JOIN mimic-iv-ext-2025.avp.avp_titration_12h h12
                    ON h6.stay_id = h12.stay_id
                        LEFT JOIN mimic-iv-ext-2025.avp.avp_titration_24h h24
                            ON h12.stay_id = h24.stay_id;


SELECT *
FROM mimic-iv-ext-2025.avp.avp_titration_upper_lower_bounds;


